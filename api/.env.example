PORT=4000
APP_ORIGIN=http://localhost:3001

DATABASE_URL=postgres://intelli-dental:intelli-dental@localhost:5432/intelli-dental

JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=7d

# rag-pipeline service
RAG_URL=http://localhost:3000
RAG_AUTH_TOKEN=change-me-in-prod

# Ollama / agentic model gateway
OLLAMA_URL=http://localhost:11434
LLM_MODEL=phi3:mini
AGENT_LLM_MODEL=phi3:mini
# Optional quality upgrade after running:
# AGENT_QUALITY_UPGRADE=true ./scripts/start.sh
# AGENT_PLAN_MODEL=llama3.2:3b
# AGENT_REWRITE_MODEL=llama3.2:3b

# Where the API stores uploaded patient documents.
# Mounted into the rag-app container at /app/data so ingest can read them.
DOCUMENTS_DIR=./data/documents
